[
  {
    "id": "claude",
    "display_name": "Claude Code",
    "description": "Anthropic Claude Code",
    "aliases": ["claude", "claude-code"],
    "install": { "type": "npm" },
    "acp": {
      "program": "node",
      "npm_package": "@agentclientprotocol/claude-agent-acp@0.66.0",
      "bin_name": "claude-agent-acp"
    },
    "pty": {
      "command": "claude code --permission-mode acceptEdits"
    },
    "resume_template": "cd {cwd} && claude --resume {session_id}",
    "global_config": {
      "settings_path": ".claude.json",
      "settings_path_legacy": ".claude/settings.json",
      "mcp_key": "mcpServers",
      "mcp_entry": { "type": "http", "url": "{mcp_url}" },
      "skill_dir": ".claude/skills/vibearound"
    }
  },
  {
    "id": "claude-desktop",
