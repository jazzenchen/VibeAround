{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VibeAround",
  "version": "0.7.24",
  "identifier": "com.vibearound.app",
  "build": {
    "beforeDevCommand": "cargo build -p va-launcher -p va-tui && node ../scripts/prepare-va-launch.mjs --profile debug --desktop && node ../scripts/build-project-plugins.mjs && bun run --cwd ../web build && bun run --cwd ../desktop-ui dev",
    "devUrl": "http://localhost:5181",
    "beforeBuildCommand": "cargo build --release -p va-launcher -p va-tui && node ../scripts/prepare-va-launch.mjs --profile release --desktop && bun run --cwd ../desktop-ui build && bun run --cwd ../web build",
    "frontendDist": "../desktop-ui/dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "default"
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "VibeAround",
        "url": "/",
        "width": 1024,
        "height": 720,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 24
        },
        "visible": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/va-launch",
      "binaries/va-tui"
    ],
    "resources": [
      "../web/dist/**/*",
      "../resources/startkit/**/*",
      "icons/32x32.png"
    ],
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "Daemon AI coding orchestrator",
    "longDescription": "Tray-first AI coding agent scheduler with Web dashboard and PTY tool adapters.",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "frameworks": []
    },
    "windows": {}
  },
  "plugins": {}
}
